rules_version = '2';
// Reglas de seguridad de la nube del Diseñador.
// Cópialas en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada quien solo puede leer y escribir sus propios diseños, plantillas, kit y lista de grupos
    match /usuarios/{uid}/{documento=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Diseños compartidos: cualquiera con el enlace los puede ver; solo su dueño los cambia o borra
    match /compartidos/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.dueno == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.dueno == request.auth.uid;
      match /partes/{parte} {
        allow read: if true;
        allow write: if request.auth != null
          && get(/databases/$(database)/documents/compartidos/$(id)).data.dueno == request.auth.uid;
      }
    }

    // MODO ESCUELA: el maestro crea el grupo y las actividades; los alumnos se unen con el código y entregan
    match /grupos/{g} {
      function grupo() { return get(/databases/$(database)/documents/grupos/$(g)).data; }
      function esMaestro() { return request.auth != null && grupo().maestro == request.auth.uid; }
      function esMiembro() { return request.auth != null && exists(/databases/$(database)/documents/grupos/$(g)/miembros/$(request.auth.uid)); }

      allow read: if request.auth != null;      // para poder buscar el grupo por su código
      allow create: if request.auth != null && request.resource.data.maestro == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.maestro == request.auth.uid;

      match /miembros/{u} {
        allow read: if esMaestro() || (request.auth != null && request.auth.uid == u);
        allow create, update: if request.auth != null && request.auth.uid == u;
        allow delete: if esMaestro() || (request.auth != null && request.auth.uid == u);
      }
      match /actividades/{a} {
        allow read: if esMaestro() || esMiembro();
        allow write: if esMaestro();
        match /partes/{p} {
          allow read: if esMaestro() || esMiembro();
          allow write: if esMaestro();
        }
        // preguntas del alumno sobre la actividad: solo las ven él y el maestro
        match /dudas/{u} {
          allow read: if esMaestro() || (request.auth != null && request.auth.uid == u);
          allow write: if esMaestro() || (request.auth != null && request.auth.uid == u && esMiembro());
          match /mensajes/{m} {
            allow read: if esMaestro() || (request.auth != null && request.auth.uid == u);
            allow create: if request.resource.data.texto is string && request.resource.data.texto.size() <= 2000
              && ((esMaestro() && request.resource.data.de == 'maestro')
                || (request.auth != null && request.auth.uid == u && esMiembro() && request.resource.data.de == 'alumno'));
            allow delete: if esMaestro();
          }
        }
        match /entregas/{u} {
          allow read: if esMaestro() || (request.auth != null && request.auth.uid == u);
          // el alumno entrega (y vuelve a entregar) sin poder cambiarse la calificación; el maestro califica
          allow create: if request.auth != null && request.auth.uid == u && esMiembro()
            && !('calificacion' in request.resource.data) && !('rubrica' in request.resource.data) && !('comentario' in request.resource.data);
          allow update: if esMaestro() || (request.auth != null && request.auth.uid == u && esMiembro()
            && request.resource.data.get('calificacion', null) == resource.data.get('calificacion', null)
            && request.resource.data.get('rubrica', null) == resource.data.get('rubrica', null)
            && request.resource.data.get('comentario', null) == resource.data.get('comentario', null));
          allow delete: if esMaestro();
          match /partes/{p} {
            allow read: if esMaestro() || (request.auth != null && request.auth.uid == u);
            allow write: if request.auth != null && request.auth.uid == u && esMiembro();
          }
          // corrección del maestro encima de la entrega (el alumno solo la puede ver)
          match /correccion/{c} {
            allow read: if esMaestro() || (request.auth != null && request.auth.uid == u);
            allow write: if esMaestro();
            match /partes/{p} {
              allow read: if esMaestro() || (request.auth != null && request.auth.uid == u);
              allow write: if esMaestro();
            }
          }
        }
      }
      // avisos del maestro para todo el grupo
      match /avisos/{v} {
        allow read: if esMaestro() || esMiembro();
        allow write: if esMaestro();
      }
      // exámenes de opción múltiple: las preguntas las ven todos los del grupo; las respuestas correctas van aparte
      match /examenes/{x} {
        allow read: if esMaestro() || esMiembro();
        allow write: if esMaestro();
        match /respuestas/{u} {
          allow read: if esMaestro() || (request.auth != null && request.auth.uid == u);
          // el alumno contesta una sola vez y no puede ponerse calificación; el maestro la guarda
          allow create: if request.auth != null && request.auth.uid == u && esMiembro()
            && !('calificacion' in request.resource.data) && !('aciertos' in request.resource.data);
          allow update, delete: if esMaestro();
        }
      }
      // calendario: fechas que agrega el maestro (exposiciones, días sin clase…)
      match /eventos/{v} {
        allow read: if esMaestro() || esMiembro();
        allow write: if esMaestro();
      }
      // pase de lista: el día completo solo lo ve el maestro; cada alumno ve solo su resumen
      match /asistencia/{f} {
        allow read, write: if esMaestro();
      }
      match /asistenciaAlumno/{u} {
        allow read: if esMaestro() || (request.auth != null && request.auth.uid == u);
        allow write: if esMaestro();
      }
      // respuestas correctas: solo el maestro; el alumno, después de contestar y si el maestro eligió mostrar resultados
      match /claves/{x} {
        allow read: if esMaestro() || (request.auth != null
          && exists(/databases/$(database)/documents/grupos/$(g)/examenes/$(x)/respuestas/$(request.auth.uid))
          && get(/databases/$(database)/documents/grupos/$(g)/examenes/$(x)).data.mostrarResultados == true);
        allow write: if esMaestro();
      }
    }

    // TELÉFONO COMO CÁMARA: la compu y el teléfono se encuentran con un código largo al azar (solo intercambian datos de conexión;
    // el video va directo entre los dos). No se pueden listar: solo quien tiene el código lo puede leer.
    match /camaras/{c} {
      allow get, delete: if c.size() >= 16;
      allow create: if c.size() >= 16 && request.resource.data.keys().hasOnly(['offer', 'creado']) && request.resource.data.offer is string && request.resource.data.offer.size() < 20000;
      allow update: if c.size() >= 16 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer']) && !('answer' in resource.data)
        && request.resource.data.answer is string && request.resource.data.answer.size() < 20000;
    }

    // TRABAJO EN EQUIPO: quien tenga el enlace (y haya entrado con su cuenta) puede ver y editar
    match /equipos/{e} {
      function abierto() { let d = get(/databases/$(database)/documents/equipos/$(e)).data; return d.abierto == true || d.dueno == request.auth.uid; }
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.dueno == request.auth.uid;
      allow update: if request.auth != null && (resource.data.dueno == request.auth.uid
        || (resource.data.abierto == true && request.resource.data.dueno == resource.data.dueno && request.resource.data.abierto == true));
      allow delete: if request.auth != null && resource.data.dueno == request.auth.uid;
      match /{seccion}/{doc} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && abierto();
      }
    }
  }
}
